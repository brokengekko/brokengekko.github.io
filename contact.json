  "title": "Contact Me",
  "stub": "contact",
  "header": null,
  "sections": [
    {
      "type": "html",
      "content": {
        "html": "<div id=\"jp-contact-container\" style=\"width: 100%; max-width: 600px; margin: 0 auto; padding-top: 20px;\">\n  <button id=\"jp-reveal-btn\" style=\"width: 100%; padding: 12px; cursor: pointer; font-weight: bold; background: transparent; border: 1px solid #00f3ff; color: #00f3ff; text-transform: uppercase; letter-spacing: 2px; box-shadow: 0 0 10px rgba(0, 243, 255, 0.2); transition: all 0.3s; font-family: inherit;\">\n    Initiate Transmission\n  </button>\n</div>\n\n<script>\n(function() {\n  const revealBtn = document.getElementById(\"jp-reveal-btn\");\n  if (revealBtn) {\n    revealBtn.addEventListener(\"click\", function(e) {\n      const container = document.getElementById(\"jp-contact-container\");\n      \n      revealBtn.style.display = \"none\";\n\n      const form = document.createElement(\"form\");\n      form.style.width = \"100%\";\n      form.style.display = \"flex\";\n      form.style.flexDirection = \"column\";\n      form.style.gap = \"15px\";\n\n      const createInput = (tag, name, placeholder, isRequired = true) => {\n        const el = document.createElement(tag);\n        if (tag === \"input\") el.type = name === \"email\" ? \"email\" : \"text\";\n        el.name = name;\n        el.placeholder = placeholder;\n        el.required = isRequired;\n        el.style.width = \"100%\";\n        el.style.boxSizing = \"border-box\";\n        el.style.padding = \"10px\";\n        el.style.background = \"rgba(0,0,0,0.4)\";\n        el.style.border = \"1px solid rgba(0, 243, 255, 0.5)\";\n        el.style.color = \"#00f3ff\";\n        el.style.fontFamily = \"inherit\";\n        return el;\n      };\n\n      const nameInput = createInput(\"input\", \"name\", \"USER_NAME\");\n      const emailInput = createInput(\"input\", \"email\", \"USER_EMAIL\");\n      const messageInput = createInput(\"textarea\", \"message\", \"TRANSMISSION_DATA\");\n      messageInput.rows = 5;\n      messageInput.style.resize = \"vertical\";\n\n      const submitBtn = document.createElement(\"button\");\n      submitBtn.type = \"submit\";\n      submitBtn.innerText = \"Send\";\n      submitBtn.style.width = \"100%\";\n      submitBtn.style.padding = \"12px\";\n      submitBtn.style.cursor = \"pointer\";\n      submitBtn.style.background = \"rgba(0, 243, 255, 0.1)\";\n      submitBtn.style.border = \"1px solid #00f3ff\";\n      submitBtn.style.color = \"#00f3ff\";\n      submitBtn.style.textTransform = \"uppercase\";\n      submitBtn.style.letterSpacing = \"2px\";\n      submitBtn.style.fontWeight = \"bold\";\n      submitBtn.style.fontFamily = \"inherit\";\n\n      form.appendChild(nameInput);\n      form.appendChild(emailInput);\n      form.appendChild(messageInput);\n      form.appendChild(submitBtn);\n\n      form.addEventListener(\"submit\", async function(event) {\n        event.preventDefault();\n\n        const nameVal = nameInput.value.trim();\n        const emailVal = emailInput.value.trim();\n        const msgVal = messageInput.value.trim();\n\n        if (nameVal && emailVal && msgVal) {\n          \n          submitBtn.innerText = \"TRANSMITTING...\";\n          submitBtn.style.color = \"#ffcc00\";\n          submitBtn.disabled = true;\n\n          const payload = {\n            name: nameVal,\n            sender_email: emailVal,\n            message: msgVal,\n            source_domain: window.location.hostname\n          };\n\n          try {\n            const response = await fetch('https://jayaprime.app.n8n.cloud/webhook/2be6d81c-1b4a-4286-a5c6-a211992c89e3', {\n              method: 'POST',\n              headers: {\n                'Content-Type': 'application/json',\n                'Accept': 'application/json'\n              },\n              body: JSON.stringify(payload)\n            });\n\n            if (response.ok) {\n              form.remove();\n\n              const successMsg = document.createElement(\"div\");\n              successMsg.innerText = \"Transmission Successfully Sent\";\n              successMsg.style.color = \"#ffcc00\"; \n              successMsg.style.fontWeight = \"bold\";\n              successMsg.style.textAlign = \"center\";\n              successMsg.style.padding = \"20px\";\n              successMsg.style.border = \"1px dashed #ffcc00\";\n              successMsg.style.background = \"rgba(255, 204, 0, 0.1)\";\n              successMsg.style.textTransform = \"uppercase\";\n              successMsg.style.letterSpacing = \"2px\";\n              \n              container.appendChild(successMsg);\n            } else {\n              throw new Error('Network response was not ok');\n            }\n          } catch (error) {\n            submitBtn.innerText = \"TRANSMISSION FAILED - RETRY\";\n            submitBtn.style.color = \"#ff0000\";\n            submitBtn.style.borderColor = \"#ff0000\";\n            submitBtn.disabled = false;\n            console.error(\"Transmission Error:\", error);\n          }\n        }\n      });\n\n      container.appendChild(form);\n    });\n  }\n})();\n</script>"
      }
    }
  ]
}